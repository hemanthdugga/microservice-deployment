pipeline {
    agent any

    environment {
        GIT_REPO_NAME = "micro-service"
        GIT_EMAIL = "221865701+hemanthdugga@users.noreply.github.com"
        GIT_USER_NAME = "hemanthdugga"
        IMAGE_NAME = "adservice"
        REPO_URL = "294500578333.dkr.ecr.ap-south-1.amazonaws.com/adservice"
        YAML_FILE = "adservice.yaml"
        GIT_TOKAN = credentials('git-tokan')
    }

    stages {
        stage('Cleaning Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Git') {
            steps {
                git branch: 'main', url: 'https://github.com/hemanthdugga/microservice-deployment.git'
            }
        }

        stage("Docker Image Build") {
            steps {
                script {
                    dir('src/adservice') {
                        sh 'docker system prune -f'
                        sh 'docker container prune -f'
                        sh 'docker build -t adservice .'
                    }
                }
            }
        }

        stage("ECR Image Pushing") {
            steps {
                script {
                    sh '''
                aws ecr get-login-password --region ap-south-1 | docker login --username AWS --password-stdin 294500578333.dkr.ecr.ap-south-1.amazonaws.com
		docker tag adservice:latest 294500578333.dkr.ecr.ap-south-1.amazonaws.com/adservice:${BUILD_NUMBER}
                    docker push 294500578333.dkr.ecr.ap-south-1.amazonaws.com/adservice:${BUILD_NUMBER}
                    '''
                }
            }
        }

    stage('Update Deployment file') {
            steps {
                dir('kubernetes-files') {
                    withCredentials([string(credentialsId: 'git-tokan', variable: 'git_token')]) {
                        sh '''
                            git config user.email "${GIT_EMAIL}"
                            git config user.name "${GIT_USER_NAME}"
                            echo $BUILD_NUMBER

                            sed -i "s#image:.*#image: ${REPO_URL}:$BUILD_NUMBER#g" ${YAML_FILE}
                            git add .
                            git commit -m "Update ${IMAGE_NAME} Image to version ${BUILD_NUMBER}"
                            git push https://${git_token}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:main
                        '''
                    }
                }
            }
        }
    }
}
