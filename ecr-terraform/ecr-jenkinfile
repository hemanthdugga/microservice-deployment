pipeline {
    agent any

    parameters {
        choice(
            name: 'ACTION',
            choices: ['apply', 'destroy'],
            description: '🔧 Select the Terraform action to perform (apply = create/update, destroy = delete all)'
        )
    }

    environment {
        TMPDIR       = "${WORKSPACE}/.tmp"
        TF_IN_AUTOMATION = "1"
        TF_LOG        = "ERROR"
        TF_LOG_PATH   = "${WORKSPACE}/tf.log"
    }

    stages {
        stage('Checkout from Git') {
            steps {
                echo 'Checking out Git repository...'
                sh 'mkdir -p "$TMPDIR"'
            }
        }

        stage('Terraform version') {
            steps {
                sh 'terraform --version'
            }
        }

        stage('Terraform init') {
            steps {
                dir('ecr-terraform') {
                    sh 'terraform init -upgrade -input=false'
                }
            }
        }

        stage('Terraform validate') {
            steps {
                dir('ecr-terraform') {
                    sh 'terraform validate'
                }
            }
        }

        stage('Terraform plan') {
            steps {
                dir('ecr-terraform') {
                    sh 'terraform plan -input=false -out=tfplan'
                }
            }
        }

        stage('Terraform apply') {
            when {
                expression { params.ACTION == 'apply' }
            }
            steps {
                dir('ecr-terraform') {
                    sh 'terraform apply -input=false tfplan'
                }
            }
        }

        stage('Terraform destroy') {
            when {
                expression { params.ACTION == 'destroy' }
            }
            steps {
                dir('ecr-terraform') {
                    sh 'terraform destroy -auto-approve -input=false'
                }
            }
        }
    }

    post {
        failure {
            archiveArtifacts artifacts: 'tf.log', allowEmptyArchive: true
            sh 'tail -100 "$TF_LOG_PATH" || true'
        }
    }
}
